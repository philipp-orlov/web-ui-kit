{
  "name": "web-ui-kit-angular-workspace",
  "private": true,
  "scripts": {
    "build": "npm --prefix ../core run build && ng build ui-kit",
    "watch": "ng build ui-kit --watch --configuration development",
    "test": "ng test ui-kit --watch=false",
    "test:node": "vitest run --config vitest.node.config.mts",
    "check": "npm --prefix ../core test && npm --prefix ../core run build && ng test ui-kit --watch=false && ng build ui-kit"
  },
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.1.0",
    "hls.js": "^1.5.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "@web-ui-kit/core": "file:../core"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@vitest/browser-playwright": "^4.0.8",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.2.0",
    "playwright": "^1.56.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
