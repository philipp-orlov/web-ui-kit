{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "packageManager": "npm", "analytics": false },
  "newProjectRoot": "lib",
  "projects": {
    "ui-kit": {
      "projectType": "library",
      "root": "lib",
      "sourceRoot": "lib",
      "prefix": "ui",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": { "project": "lib/ng-package.json", "tsConfig": "tsconfig.lib.json" },
          "configurations": {
            "production": { "tsConfig": "tsconfig.lib.prod.json" },
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "browsers": ["chromiumHeadless"],
            "browserViewport": "1280x900",
            "exclude": ["lib/export/**"],
            "providersFile": "testing/providers.ts"
          }
        }
      }
    }
  }
}
